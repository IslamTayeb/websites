{
  "name": "imt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build && node scripts/check-open-sans.mjs",
    "start": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render:profile-picture": "node scripts/render-profile-picture.mjs",
    "generate:redirects": "node scripts/generate-apm-redirects.mjs",
    "test": "npm run test:content && npm run test:migration && npm run test:pageview && npm run test:no-motion",
    "test:content": "tsx scripts/test-content.ts",
    "test:migration": "tsx scripts/test-migration.ts",
    "test:pageview": "tsx scripts/test-pageview.ts && tsx scripts/test-network-enrichment.ts && tsx scripts/test-visit-storage.ts && tsx scripts/test-visit-processing.ts",
    "test:no-motion": "node scripts/test-no-motion.mjs",
    "test:visual": "tsx scripts/test-visual.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@neondatabase/serverless": "1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.10.1",
    "astro": "^7.4.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "browserslist": "^4.29.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss": "^1.33.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.2"
  }
}
